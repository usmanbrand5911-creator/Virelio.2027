generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-arm64-openssl-1.1.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethodType {
  JAZZCASH
  EASYPAISA
  BANK_TRANSFER
}

enum SubmissionStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CORRECTION_REQUIRED
  CANCELLED
}

enum WithdrawalStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  PROCESSING
  PAID
  REJECTED
  CANCELLED
  FAILED
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  username        String           @unique
  phone           String?
  passwordHash    String
  avatarUrl       String?
  googleId        String?
  role            Role             @default(USER)
  emailVerified   Boolean          @default(false)
  isApproved      Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  wallet          Wallet?
  orders          Order[]
  taskSubmissions TaskSubmission[]
  withdrawals     Withdrawal[]
  notifications   Notification[]

  @@map("users")
}

model Wallet {
  id               String              @id @default(uuid())
  userId           String              @unique
  availableBalance Decimal             @default(0.00) @db.Decimal(12, 2)
  pendingBalance   Decimal             @default(0.00) @db.Decimal(12, 2)
  totalEarned      Decimal             @default(0.00) @db.Decimal(12, 2)
  totalWithdrawn   Decimal             @default(0.00) @db.Decimal(12, 2)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions     WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id          String   @id @default(uuid())
  walletId    String
  amount      Decimal  @db.Decimal(12, 2)
  type        String   
  status      String   
  reference   String?
  description String
  createdAt   DateTime @default(now())

  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
}

model Product {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  description String
  price       Decimal      @db.Decimal(10, 2)
  discount    Decimal      @default(0.00) @db.Decimal(10, 2)
  finalPrice  Decimal      @db.Decimal(10, 2)
  stock       Int          @default(0)
  status      String       @default("PUBLISHED")
  imageUrl    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  orderItems  OrderItem[]

  @@map("products")
}

model Order {
  id              String            @id @default(uuid())
  orderNumber     String            @unique
  userId          String
  totalAmount     Decimal           @db.Decimal(10, 2)
  orderStatus     OrderStatus       @default(PENDING)
  paymentStatus   PaymentStatus     @default(PENDING)
  paymentMethod   PaymentMethodType
  paymentRef      String?
  shippingAddress Json
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  paymentRecords  PaymentRecord[]

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model PaymentRecord {
  id             String            @id @default(uuid())
  orderId        String
  method         PaymentMethodType
  accountNumber  String
  accountTitle   String
  transactionRef String
  amount         Decimal           @db.Decimal(10, 2)
  status         PaymentStatus     @default(PENDING)
  createdAt      DateTime          @default(now())

  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payment_records")
}

model PaymentMethodSetting {
  id            String            @id @default(uuid())
  type          PaymentMethodType @unique
  accountNumber String
  accountTitle  String
  instructions  String
  isEnabled     Boolean           @default(true)
  updatedAt     DateTime          @updatedAt

  @@map("payment_method_settings")
}

model Task {
  id               String           @id @default(uuid())
  title            String
  description      String
  category         String
  reward           Decimal          @db.Decimal(10, 2)
  instructions     String
  link             String?
  participantLimit Int              @default(100)
  currentCount     Int              @default(0)
  status           String           @default("PUBLISHED")
  endDate          DateTime
  createdAt        DateTime         @default(now())

  submissions      TaskSubmission[]

  @@map("tasks")
}

model TaskSubmission {
  id            String           @id @default(uuid())
  taskId        String
  userId        String
  proofText     String
  proofMediaUrl String?
  status        SubmissionStatus @default(SUBMITTED)
  adminFeedback String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  task          Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@map("task_submissions")
}

model Withdrawal {
  id            String           @id @default(uuid())
  withdrawalNo  String           @unique
  userId        String
  amount        Decimal          @db.Decimal(10, 2)
  method        PaymentMethodType
  accountNumber String
  accountTitle  String
  cnicNumber    String?
  selfieUrl     String?
  status        WithdrawalStatus @default(PENDING)
  adminNote     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("withdrawals")
}

model GuestPost {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  authorName  String
  authorEmail String
  content     String
  status      String   @default("SUBMITTED")
  createdAt   DateTime @default(now())

  @@map("guest_posts")
}

model Page {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String?
  sections    Json
  isPublished Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@map("pages")
}

model NavigationItem {
  id        String   @id @default(uuid())
  label     String
  path      String
  order     Int      @default(0)
  isEnabled Boolean  @default(true)

  @@map("navigation_items")
}

model SocialLink {
  id        String   @id @default(uuid())
  platform  String   @unique
  url       String
  isEnabled Boolean  @default(true)

  @@map("social_links")
}

model WhatsAppSetting {
  id         String   @id @default("default")
  phone      String
  isEnabled  Boolean  @default(true)
  position   String   @default("bottom-right")
  label      String   @default("Chat with Us")
  modalTitle String   @default("Virelio Customer Support")
  greeting   String   @default("Hello! How can we assist you today?")
  updatedAt  DateTime @updatedAt

  @@map("whatsapp_settings")
}

model BrandingSetting {
  id        String   @id @default("default")
  siteName  String   @default("Virelio")
  logoUrl   String   @default("/virelio-logo.png")
  updatedAt DateTime @updatedAt

  @@map("branding_settings")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
